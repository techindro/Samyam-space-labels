# Example Environment Variables (Do not commit real keys here)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="your_supabase_url"
VITE_OAUTH_ENABLED="true"
GROQ_API_KEY="your_groq_api_key"
VITE_FASTAPI_URL="http://localhost:8000"

# Amazon Web Services (AWS) S3 Storage
VITE_AWS_REGION="us-east-1"
VITE_AWS_S3_BUCKET_NAME="samyam-satellite-datasets"
VITE_AWS_ACCESS_KEY_ID="your_aws_access_key_id"
VITE_AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# Razorpay Payment Gateway
# Get test keys from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXX"
# RAZORPAY_KEY_SECRET goes in Supabase secrets (never in frontend)
