{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": [
    "voice-agent/**/*.ts",
    "deno.d.ts"
  ]
}
